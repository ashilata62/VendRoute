generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Settings {
  id        String   @id @default("global")
  data      String   @db.LongText
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model customer {
  id            String     @id
  companyName   String
  contactPerson String
  email         String
  phone         String
  industry      String?
  createdAt     DateTime   @default(now())
  location      location[]
}

model livetracking {
  id        String   @id
  driverId  String
  latitude  Float
  longitude Float
  speed     Float?
  heading   Float?
  accuracy  Float?
  timestamp DateTime @default(now())
  user      user     @relation(fields: [driverId], references: [id], map: "LiveTracking_driverId_fkey")

  @@index([driverId], map: "LiveTracking_driverId_fkey")
}

model location {
  id         String      @id
  customerId String
  name       String
  address    String
  city       String
  latitude   Float
  longitude  Float
  imageUrl   String?     @db.LongText
  createdAt  DateTime    @default(now())
  products   String?     @db.LongText
  customer   customer    @relation(fields: [customerId], references: [id], onDelete: Cascade, map: "Location_customerId_fkey")
  machine    machine[]
  routestop  routestop[]

  @@index([customerId], map: "Location_customerId_fkey")
}

model machine {
  id          String         @id
  locationId  String
  machineCode String         @unique(map: "Machine_machineCode_key")
  model       String
  fillLevel   Float          @default(100)
  status      machine_status @default(ACTIVE)
  lastRefill  DateTime       @default(now())
  location    location       @relation(fields: [locationId], references: [id], onDelete: Cascade, map: "Machine_locationId_fkey")

  @@index([locationId], map: "Machine_locationId_fkey")
}

model notification {
  id        String            @id @default(uuid())
  userId    String
  title     String
  message   String            @db.Text
  type      notification_type @default(info)
  read      Boolean           @default(false)
  createdAt DateTime          @default(now())
  user      user              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model route {
  id            String       @id
  driverId      String
  name          String
  date          String
  vehicleId     String?
  totalDistance   Float        @default(0)
  plannedDistance Float        @default(0)
  actualDistance  Float        @default(0)
  estimatedTime   Int          @default(0)
  plannedDuration Int          @default(0)
  actualDuration  Int          @default(0)
  actualTime      Int?
  startTime     DateTime?
  endTime       DateTime?
  status        route_status @default(PENDING)
  createdAt     DateTime     @default(now())
  user          user         @relation(fields: [driverId], references: [id], map: "Route_driverId_fkey")
  vehicle       vehicle?     @relation(fields: [vehicleId], references: [id], map: "Route_vehicleId_fkey")
  routestop     routestop[]

  @@index([driverId], map: "Route_driverId_fkey")
  @@index([vehicleId], map: "Route_vehicleId_fkey")
}

model routestop {
  id               String           @id
  routeId          String
  locationId       String
  stopOrder        Int
  status           routestop_status @default(PENDING)
  gpsVerified      Boolean          @default(false)
  cashCollected    Float            @default(0)
  productsRefilled String?          @db.LongText
  signatureUrl     String?          @db.LongText
  machineIssues    String?
  photos           String?          @db.LongText
  notes            String?
  arrivalTime      DateTime?
  departureTime    DateTime?
  location         location         @relation(fields: [locationId], references: [id], map: "RouteStop_locationId_fkey")
  route            route            @relation(fields: [routeId], references: [id], onDelete: Cascade, map: "RouteStop_routeId_fkey")
  inventorylog     inventorylog[]

  @@index([locationId], map: "RouteStop_locationId_fkey")
  @@index([routeId], map: "RouteStop_routeId_fkey")
}

model user {
  id               String         @id
  name             String
  email            String         @unique(map: "User_email_key")
  password         String
  role             user_role      @default(DRIVER)
  phone            String?
  address          String?
  licenseNumber    String?
  emergencyContact String?
  resetOtp         String?
  resetOtpExpires  DateTime?
  isOnline         Boolean        @default(true)
  avatar           String?        @db.LongText
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  livetracking     livetracking[]
  route            route[]
  vehicle          vehicle[]
  attendance        attendance[]
  inventorylog      inventorylog[]
  notification      notification[]
  notificationtoken notificationtoken[]
}

model vehicle {
  id               String         @id
  model            String
  plateNumber      String         @unique(map: "Vehicle_plateNumber_key")
  type             String
  fuelType         String
  lastMaintenance  String?
  nextMaintenance  String?
  gpsDeviceId      String?
  currentFuelLevel Float          @default(100)
  odometer         Float          @default(0)
  assignedDriverId String?
  status           vehicle_status @default(IN_USE)
  createdAt        DateTime       @default(now())
  route            route[]
  user             user?          @relation(fields: [assignedDriverId], references: [id], map: "Vehicle_assignedDriverId_fkey")

  @@index([assignedDriverId], map: "Vehicle_assignedDriverId_fkey")
}

model attendance {
  id           String    @id @default(uuid())
  driverId     String
  date         String    // YYYY-MM-DD format
  punchIn      DateTime
  punchOut     DateTime?
  breakStart   DateTime?
  breakEnd     DateTime?
  workingHours Float     @default(0)
  status       String    @default("PRESENT")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         user      @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
}

model inventorylog {
  id              String    @id @default(uuid())
  routeStopId     String
  driverId        String
  productId       String
  quantityAdded   Int       @default(0)
  quantityRemoved Int       @default(0)
  remarks         String?
  createdAt       DateTime  @default(now())

  user            user      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  routestop       routestop @relation(fields: [routeStopId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([routeStopId])
}

model notificationtoken {
  id          String   @id @default(uuid())
  driverId    String
  deviceToken String   @unique
  platform    String?  // ios, android, web
  createdAt   DateTime @default(now())

  user        user     @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
}

enum notification_type {
  info
  warning
  success
  error
}

enum routestop_status {
  PENDING
  REACHED
  COMPLETED
  SKIPPED
}

enum user_role {
  ADMIN
  SUPERVISOR
  DRIVER
  CUSTOMER
}

enum machine_status {
  ACTIVE
  INACTIVE
  NEEDS_MAINTENANCE
  OUT_OF_STOCK
}

enum route_status {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum vehicle_status {
  IN_USE
  MAINTENANCE
}
