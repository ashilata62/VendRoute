generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
  DRIVER
  CUSTOMER
}

enum MachineStatus {
  ACTIVE
  INACTIVE
  NEEDS_MAINTENANCE
  OUT_OF_STOCK
}

enum VehicleStatus {
  IN_USE
  MAINTENANCE
}

enum RouteStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StopStatus {
  PENDING
  REACHED
  COMPLETED
  SKIPPED
}

enum NotificationType {
  info
  warning
  success
  error
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  password         String
  role             Role      @default(DRIVER)
  phone            String?
  address          String?
  licenseNumber    String?
  emergencyContact String?
  resetOtp         String?
  resetOtpExpires  DateTime?
  avatar           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assignedRoutes Route[]
  trackingLogs   LiveTracking[]
  assignedVehicles Vehicle[]
}

model Customer {
  id            String   @id @default(uuid())
  companyName   String
  contactPerson String
  email         String
  phone         String
  industry      String?
  createdAt     DateTime @default(now())

  locations     Location[]
}

model Location {
  id          String    @id @default(uuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  address     String
  city        String
  latitude    Float
  longitude   Float
  imageUrl    String?   @db.LongText
  products    Json?
  createdAt   DateTime  @default(now())

  machines    Machine[]
  routeStops  RouteStop[]
}

model Machine {
  id          String        @id @default(uuid())
  locationId  String
  location    Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  machineCode String        @unique
  model       String
  fillLevel   Float         @default(100)
  status      MachineStatus @default(ACTIVE)
  lastRefill  DateTime      @default(now())
}

model Route {
  id            String      @id @default(uuid())
  driverId      String
  driver        User        @relation(fields: [driverId], references: [id])
  name          String
  date          String
  vehicleId     String?
  vehicle       Vehicle?    @relation(fields: [vehicleId], references: [id])
  totalDistance Float       @default(0)
  estimatedTime Int         @default(0)
  actualTime    Int?
  startTime     DateTime?
  endTime       DateTime?
  status        RouteStatus @default(PENDING)
  createdAt     DateTime    @default(now())

  stops         RouteStop[]
}

model Vehicle {
  id               String        @id @default(uuid())
  model            String
  plateNumber      String        @unique
  type             String
  fuelType         String
  lastMaintenance  String?
  nextMaintenance  String?
  gpsDeviceId      String?
  currentFuelLevel Float         @default(100)
  odometer         Float         @default(0)
  assignedDriverId String?
  driver           User?         @relation(fields: [assignedDriverId], references: [id])
  status           VehicleStatus @default(IN_USE)
  createdAt        DateTime      @default(now())

  routes           Route[]
}

model RouteStop {
  id          String     @id @default(uuid())
  routeId     String
  route       Route      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  locationId  String
  location    Location   @relation(fields: [locationId], references: [id])
  stopOrder   Int
  status           StopStatus @default(PENDING)
  gpsVerified      Boolean    @default(false)
  cashCollected    Float      @default(0)
  productsRefilled Json?
  signatureUrl     String?    @db.LongText
  notes            String?
}

model LiveTracking {
  id        String   @id @default(uuid())
  driverId  String
  driver    User     @relation(fields: [driverId], references: [id])
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  title     String
  message   String           @db.Text
  type      NotificationType @default(info)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model Settings {
  id        String   @id @default("global")
  data      Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}